{
  "project": {
    "name": "Unified Spotify Playlist -> YT Music -> Telugu Word LRC -> Whole-song 8D -> Reel",
    "version": "1.4.28-gpu-hardening",
    "plan": "PROJECT_PLAN.md",
    "pipeline_version": "1.4.28-cuda-first-demucs-mms-silero-nvenc-device-aware-cache"
  },
  "playlist": {
    "provider": "spotify",
    "spotify_playlist_id": "",
    "scan_complete_once": true,
    "process_in_exact_playlist_order": true
  },
  "paths": {
    "database_dir": "db",
    "songs_final": "songs/final",
    "skipped_no_sync": "songs/skipped/no_synced_lrc",
    "reels_generated": "reels/generated",
    "work_dir": "temp",
    "models_dir": "models",
    "fonts_dir": "assets/fonts",
    "logs_dir": "logs"
  },
  "ffmpeg_location": null,
  "spotify": {
    "enabled": true,
    "auth_file": "spotify_auth.json",
    "client_id": "",
    "client_secret": "",
    "use_env": true,
    "market": "IN",
    "timeout_seconds": 30,
    "max_retries": 4,
    "redirect_uri": "http://127.0.0.1:8080",
    "require_user_auth": true
  },
  "ytmusic": {
    "search_limit": 10,
    "duration_tolerance_ms": 2000,
    "timeout_seconds": 60,
    "download_timeout_seconds": 1800,
    "video_max_height": 1080,
    "ignore_spelling": false,
    "yt_dlp": {
      "format_selector": "bestaudio/best",
      "audio_format": "mp3",
      "audio_quality_kbps": 320,
      "retries": 3,
      "fragment_retries": 3,
      "socket_timeout_seconds": 60,
      "cookies_from_browser": null,
      "cookie_file": null
    }
  },
  "lyrics": {
    "enabled": true,
    "endpoint": "/api/get",
    "timeout_seconds": 30,
    "max_retries": 3,
    "request_delay_seconds": 0.5,
    "font_filename": "BalooTammudu2-ExtraBold.ttf",
    "font_name": "Baloo Tammudu 2 ExtraBold",
    "font_size": 58,
    "font_bold": true,
    "outline": 3,
    "shadow": 4,
    "center_x": 540,
    "center_y": 960,
    "base_color": "#FFFFFF",
    "current_color": "#FFD65A",
    "completed_color": "#FFFFFF",
    "max_chars_single_line": 30,
    "min_scale_x": 70,
    "download_only_synced": true,
    "search_fallback_enabled": true,
    "search_queries": "title + artist, then title",
    "search_endpoint": "/api/search",
    "strategy_version": "lrclib-get-then-search-v2"
  },
  "duplicate_detection": {
    "enabled": true,
    "identifier": "isrc",
    "on_duplicate": "prompt",
    "search_only_finalized": true
  },
  "youtube_offset": {
    "reference_duration_ms": 30000,
    "max_accepted_offset_ms": 30000,
    "scan_step_ms": 250,
    "download_timeout_seconds": 900,
    "method_version": "unified-offset-v1"
  },
  "models": {
    "mms_model": "facebook/mms-1b-all",
    "mms_revision": null,
    "language_iso1": "te",
    "language_iso3": "tel",
    "demucs_model": "htdemucs",
    "cache_policy": "project-persistent",
    "cache_root": "models"
  },
  "runtime": {
    "device": "cuda",
    "fallback_device": "cpu",
    "require_cuda": true,
    "allow_cpu_fallback": false,
    "print_device_banner": true,
    "gpu_policy": "cuda_first_for_torch_models_and_nvenc;cpu_for_io_network_metadata_and_numpy_only_stages",
    "cuda_device": "cuda:0"
  },
  "audio": {
    "sample_rate": 16000,
    "minimum_duration_ms": 5000
  },
  "demucs": {
    "model": "htdemucs",
    "segment_seconds": 8,
    "retry_segment_seconds": 8,
    "timeout_seconds": 7200
  },
  "vad": {
    "enabled": true,
    "threshold": 0.5,
    "min_speech_duration_ms": 250,
    "min_silence_duration_ms": 300,
    "speech_pad_ms": 150,
    "energy_threshold_db": -38.0
  },
  "chunking": {
    "min_seconds": 4.0,
    "target_seconds": 12.0,
    "max_seconds": 20.0,
    "context_before_ms": 500,
    "context_after_ms": 500,
    "pause_threshold_ms": 1500,
    "large_gap_threshold_ms": 3000
  },
  "alignment": {
    "global_retry_max_chunks": 6,
    "global_retry_attempts_per_chunk": 2,
    "reject_lyric_crossing_blank_marker": true,
    "final_timing_repair_enabled": true,
    "final_timing_repair_max_ms": 5000
  },
  "audio_8d": {
    "sample_rate": 44100,
    "bitrate": "320k",
    "other_frequency_hz": 0.075,
    "other_width": 0.75,
    "drums_frequency_hz": 0.045,
    "drums_width": 0.14,
    "drums_center": 0.88,
    "vocal_center": 0.98,
    "bass_pan": 0.0,
    "fade_in_ms": 100,
    "fade_out_ms": 250,
    "min_mono_compatibility_ratio": 0.2
  },
  "hook": {
    "max_duration_ms": null,
    "input_method": "terminal",
    "skip": true,
    "queue_file": "songs/final/hook_queue.json"
  },
  "video_match": {
    "guard_before_ms": 1500,
    "guard_after_ms": 1500
  },
  "video_layout": {
    "output_width": 1080,
    "output_height": 1920,
    "height_fraction": 0.8
  },
  "render": {
    "video_codec": "h264_nvenc",
    "video_codec_fallback": "libx264",
    "preset": "fast",
    "crf": 18,
    "audio_bitrate": "192k",
    "nvenc_gpu": "auto"
  },
  "recovery": {
    "stale_after_minutes": 30,
    "reconcile_on_start": true
  },
  "youtube_video_search": {
    "results_to_fetch": 20,
    "selection_rule": "title + album + video song hd; skip lyric/lyrics/lyrical titles; first remaining result; no duration filtering"
  },
  "version": "1.4.28-gpu-hardening",
  "pipeline_version": "1.4.28-cuda-first-demucs-mms-silero-nvenc-device-aware-cache"
}
